# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
# These values are for LOCAL DEVELOPMENT ONLY.

# PostgreSQL container (docker-compose). Port 5433 avoids clashing with a
# PostgreSQL already installed on the default port 5432.
POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_PORT=5433

# Used by the API and Alembic migrations.
# Docker database: port 5433. A PostgreSQL installed directly on Windows: usually port 5432.
DATABASE_URL=postgresql+psycopg://inventory:change-me-local-dev-only@localhost:5433/inventory

# Secret used to sign login tokens. Generate your own with:
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, a temporary key is used and everyone is logged out on restart.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Port for the web app when running with Docker (http://localhost:8080).
WEB_PORT=8080

# Set to true to log every SQL statement (debugging only).
SQL_ECHO=false
